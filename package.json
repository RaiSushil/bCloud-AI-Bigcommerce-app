{
  "name": "bcloud-bigcommerce-app",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "build:storefront": "node scripts/build-storefront.mjs",
    "dev": "react-router dev",
    "dev:local": "node --env-file=.env ./node_modules/@react-router/dev/bin.js dev",
    "start:local": "node --env-file=.env ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "prisma": "prisma",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "isbot": "^5.1.31",
    "lucide-react": "^1.55.0",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "recharts": "^3.10.1",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
